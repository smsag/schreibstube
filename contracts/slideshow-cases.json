{
  "comment": "The slideshow block is read by the plugin in the vault and again by the bridge for the site, and the plugin also collects the files it uploads from it. Both suites run these cases, so the readings cannot drift apart. 'images' is what the block names; 'shown' is how many of them its layout shows; 'files' is the vault file each image must be found as, both when the plugin uploads it and when the bridge looks it up.",
  "cases": [
    {
      "name": "two images, the default layout",
      "source": "![Eins](a.png)\n![Zwei](b.png)",
      "expect": {
        "ok": true,
        "layout": "slideshow",
        "images": [
          {
            "src": "a.png",
            "alt": "Eins"
          },
          {
            "src": "b.png",
            "alt": "Zwei"
          }
        ],
        "shown": 2,
        "files": ["a.png", "b.png"]
      }
    },
    {
      "name": "blank lines and comments are ignored",
      "source": "// Urlaub\n\n![](a.png)\n\n// zweites\n![](b.png)\n",
      "expect": {
        "ok": true,
        "layout": "slideshow",
        "images": [
          {
            "src": "a.png",
            "alt": ""
          },
          {
            "src": "b.png",
            "alt": ""
          }
        ],
        "shown": 2,
        "files": ["a.png", "b.png"]
      }
    },
    {
      "name": "a layout line anywhere, in any case",
      "source": "![a](a.png)\nLayout:  Filmstrip\n![b](b.png)",
      "expect": {
        "ok": true,
        "layout": "filmstrip",
        "images": [
          {
            "src": "a.png",
            "alt": "a"
          },
          {
            "src": "b.png",
            "alt": "b"
          }
        ],
        "shown": 2,
        "files": ["a.png", "b.png"]
      }
    },
    {
      "name": "indented lines and CRLF",
      "source": "  ![a](a.png)  \r\n\t![b](b.png)\r\n",
      "expect": {
        "ok": true,
        "layout": "slideshow",
        "images": [
          {
            "src": "a.png",
            "alt": "a"
          },
          {
            "src": "b.png",
            "alt": "b"
          }
        ],
        "shown": 2,
        "files": ["a.png", "b.png"]
      }
    },
    {
      "name": "a path in angle brackets or with %20 is kept as written",
      "source": "![a](<my photo.png>)\n![b](my%20photo.png)",
      "expect": {
        "ok": true,
        "layout": "slideshow",
        "images": [
          {
            "src": "<my photo.png>",
            "alt": "a"
          },
          {
            "src": "my%20photo.png",
            "alt": "b"
          }
        ],
        "shown": 2,
        "files": ["my photo.png", "my photo.png"]
      }
    },
    {
      "name": "a bare space in a path is allowed, as in the vault",
      "source": "![a](my photo.png)\n![b](Grundriss EG.png)",
      "expect": {
        "ok": true,
        "layout": "slideshow",
        "images": [
          {
            "src": "my photo.png",
            "alt": "a"
          },
          {
            "src": "Grundriss EG.png",
            "alt": "b"
          }
        ],
        "shown": 2,
        "files": ["my photo.png", "Grundriss EG.png"]
      }
    },
    {
      "name": "alt text is trimmed",
      "source": "![  Das Haus  ](a.png)\n![b](b.png)",
      "expect": {
        "ok": true,
        "layout": "slideshow",
        "images": [
          {
            "src": "a.png",
            "alt": "Das Haus"
          },
          {
            "src": "b.png",
            "alt": "b"
          }
        ],
        "shown": 2,
        "files": ["a.png", "b.png"]
      }
    },
    {
      "name": "a feature shows its first three",
      "source": "layout: feature\n![](1.png)\n![](2.png)\n![](3.png)\n![](4.png)",
      "expect": {
        "ok": true,
        "layout": "feature",
        "images": [
          {
            "src": "1.png",
            "alt": ""
          },
          {
            "src": "2.png",
            "alt": ""
          },
          {
            "src": "3.png",
            "alt": ""
          },
          {
            "src": "4.png",
            "alt": ""
          }
        ],
        "shown": 3,
        "files": ["1.png", "2.png", "3.png", "4.png"]
      }
    },
    {
      "name": "a comparison shows its first two",
      "source": "layout: compare\n![Vorher](1.png)\n![Nachher](2.png)\n![](3.png)",
      "expect": {
        "ok": true,
        "layout": "compare",
        "images": [
          {
            "src": "1.png",
            "alt": "Vorher"
          },
          {
            "src": "2.png",
            "alt": "Nachher"
          },
          {
            "src": "3.png",
            "alt": ""
          }
        ],
        "shown": 2,
        "files": ["1.png", "2.png", "3.png"]
      }
    },
    {
      "name": "strip and masonry show every image",
      "source": "layout: masonry\n![](1.png)\n![](2.png)\n![](3.png)\n![](4.png)\n![](5.png)",
      "expect": {
        "ok": true,
        "layout": "masonry",
        "images": [
          {
            "src": "1.png",
            "alt": ""
          },
          {
            "src": "2.png",
            "alt": ""
          },
          {
            "src": "3.png",
            "alt": ""
          },
          {
            "src": "4.png",
            "alt": ""
          },
          {
            "src": "5.png",
            "alt": ""
          }
        ],
        "shown": 5,
        "files": ["1.png", "2.png", "3.png", "4.png", "5.png"]
      }
    },
    {
      "name": "one image is not a slideshow",
      "source": "![a](a.png)",
      "expect": {
        "ok": false
      }
    },
    {
      "name": "an empty block is not a slideshow",
      "source": "\n// nur ein Kommentar\n",
      "expect": {
        "ok": false
      }
    },
    {
      "name": "a wikilink embed is refused, not dropped",
      "source": "![a](a.png)\n![[b.png]]",
      "expect": {
        "ok": false
      }
    },
    {
      "name": "a stray word is refused",
      "source": "![a](a.png)\nFoto\n![b](b.png)",
      "expect": {
        "ok": false
      }
    },
    {
      "name": "an unknown layout is refused",
      "source": "layout: carousel\n![a](a.png)\n![b](b.png)",
      "expect": {
        "ok": false
      }
    },
    {
      "name": "an empty path is refused",
      "source": "![a]( )\n![b](b.png)",
      "expect": {
        "ok": false
      }
    },
