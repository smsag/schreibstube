{
  "name": "schreibstube",
  "version": "1.88.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Schreibstube Obsidian community plugin",
  "scripts": {
    "setup": "npm install && npm install --prefix bridge",
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production && node scripts/check-bundle.mjs",
    "build:icons": "node scripts/build-icon-font.mjs",
    "build:print-examples": "node scripts/build-print-examples.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/check-deps.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/check-deps.mjs",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "check:obsidian-cascade": "node scripts/obsidian-button-rules.mjs",
    "check:print": "node scripts/check-print-compile.mjs",
    "release": "node scripts/release.mjs",
    "trace": "node scripts/trace.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
