{
  "name": "schreibstube",
  "version": "1.24.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Schreibstube Obsidian community plugin",
  "scripts": {
    "setup": "npm install && npm install --prefix bridge",
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs --production && node scripts/check-bundle.mjs",
    "build:icons": "node scripts/build-icon-font.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/check-deps.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "release": "node scripts/release.mjs",
    "trace": "node scripts/trace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "obsidian": "^1.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
