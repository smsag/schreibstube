node_modules
# The image builds its own from the package in the deps stage.
vendor
npm-debug.log
# Every local environment file, not only the one the README names: a copy
# such as .env.production would otherwise be baked into an image layer.
.env
.env.*

# Tests and their fixtures are run from the repository, never from the image.
*.test.mjs
publish/**/*.test.mjs
publish/sftp-fixture.mjs
publish/bench.mjs
