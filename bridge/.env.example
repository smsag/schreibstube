# --- Bridge ---------------------------------------------------------------
PORT=8080
# Budgets. A request that has not finished by now is not going to, and every
# outbound protocol operation carries its own deadline.
REQUEST_TIMEOUT_MS=30000
UPSTREAM_TIMEOUT_MS=20000
# Repeated authentication failures from one address earn a delay, then a 429.
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_MS=60000
# How long a shutdown waits for in-flight work before exiting anyway.
DRAIN_TIMEOUT_MS=10000
# Set to true behind a hosting platform's proxy (Sliplane, Fly, Railway, a
# Caddy or nginx in front). The throttle then keys on the address the proxy
# appended to X-Forwarded-For rather than on the proxy's own, which every
# caller shares. Leave unset when clients can reach the bridge directly.
TRUST_PROXY=false
# "json" for a hosting dashboard that can search fields; anything else stays
# human-readable, which is what a person tailing the log wants.
LOG_FORMAT=text

# --- Mail capability ------------------------------------------------------
# Present these variables and the bridge offers mail; omit them all and it does
# not. At least one capability must be configured or the bridge refuses to start.
# The token the plugin sends as "Authorization: Bearer <token>", for the mail
# routes only. Generate with: openssl rand -base64 32
MAIL_TOKEN=replace-me-with-at-least-24-characters

# Mailbox (Strato example).
IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true

MAIL_USER=you@your-domain.de
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM=Your Name <you@your-domain.de>

# --- Mail, optional -------------------------------------------------------
# Mailbox searched when the plugin does not name one.
DEFAULT_MAILBOX=INBOX
# Mailbox that receives the APPENDed copy of each sent message.
# Set to an empty value to skip filing entirely.
SENT_MAILBOX=Sent
# Guard rails.
MAX_BODY_BYTES=1000000
MAX_TEXT_CHARS=40000
# The most one fetched message may weigh on the wire, attachments included.
MAX_MESSAGE_BYTES=10000000
MAX_RESULTS=50

# --- Publish capability ---------------------------------------------------
# Present these variables and the bridge offers publishing; omit them all and it
# does not. The token is deliberately separate from MAIL_TOKEN, so a leaked
# publish token cannot reach the mailbox.
PUBLISH_TOKEN=replace-me-with-at-least-24-characters
PUBLISH_TARGETS=blog

# One block per target named above, prefixed PUBLISH_<TARGET>_.
PUBLISH_BLOG_HOST=sftp.example.com
PUBLISH_BLOG_PORT=22
PUBLISH_BLOG_USER=web123
# Either a key (base64 of an OpenSSH private key) or a password, never both.
PUBLISH_BLOG_KEY=
PUBLISH_BLOG_KEY_PASSPHRASE=
PUBLISH_BLOG_PASSWORD=
# Required. Read it with: ssh-keyscan -t rsa your-host | ssh-keygen -lf -
PUBLISH_BLOG_HOST_FINGERPRINT=SHA256:...
# The web root, and where the sources and the manifest live. Keep the state out
# of the served tree where the host allows it; otherwise deny /.schreibstube/.
PUBLISH_BLOG_ROOT=/var/www/blog
PUBLISH_BLOG_STATE_ROOT=/var/schreibstube/blog
PUBLISH_BLOG_BASE_URL=https://blog.example.com
PUBLISH_BLOG_SITE_TITLE=Schreibstube
# Images and video only; anything else on the site is written by the bridge.
PUBLISH_BLOG_ALLOWED_EXT=png,jpg,jpeg,gif,webp,avif,svg,mp4,webm,ogv,mov,m4v
# Raw HTML written inside a note. True for a personal site; consider false for a
# vault with more than one author.
PUBLISH_BLOG_ALLOW_HTML=true
# Mermaid diagrams. A page with one loads a five megabyte bundle, so a site that
# never draws a diagram can turn the possibility off.
PUBLISH_BLOG_ALLOW_DIAGRAMS=true

# Guard rails.
PUBLISH_MAX_SOURCE_BYTES=2000000
PUBLISH_MAX_IMAGE_BYTES=10000000
PUBLISH_MAX_VIDEO_BYTES=25000000
PUBLISH_MAX_FILES=2000
# The body cap for /publish/plan and /publish/commit, which carry the index.
PUBLISH_MAX_INDEX_BYTES=4000000

# --- Plan capability ------------------------------------------------------
# Present these variables and the bridge offers planning; omit them all and it
# does not. This is the one capability that keeps something between requests:
# a single JSON document, latest revision only, no history.
PLAN_TOKEN=replace-me-with-at-least-24-characters

# Where that document lives. Point this at a mounted volume, or the planner is
# empty again after every redeploy. The file is created on the first write.
PLAN_STORE=./data/plan.json

# The calendar home collection — the one whose children are the calendars —
# not the server root. For iCloud that is
# https://caldav.icloud.com/<numeric id>/calendars/, and the password must be
# an app-specific one from your Apple account.
CALDAV_URL=https://caldav.example.com/dav/you/calendars/
CALDAV_USER=you@example.com
CALDAV_PASSWORD=your-app-specific-password

# --- Plan, optional -------------------------------------------------------
# Which calendars the vault may read and write, comma separated. Leave empty
# and the bridge asks the server and offers everything it finds; name them and
# nothing else is reachable, whatever a request says.
CALDAV_CALENDARS=
# Guard rails. The document itself is capped at 512 KB whatever this says; the
# body carries it plus a revision.
PLAN_MAX_BODY_BYTES=600000
# The most one calendar answer may weigh before it is abandoned.
PLAN_MAX_RESPONSE_BYTES=8000000
