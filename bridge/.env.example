# --- Bridge ---------------------------------------------------------------
# Shared secret the Obsidian plugin sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -base64 32
BRIDGE_TOKEN=replace-me-with-at-least-24-characters
PORT=8080

# --- Mailbox (Strato example) ---------------------------------------------
IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true

MAIL_USER=you@your-domain.de
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM=Your Name <you@your-domain.de>

# --- Optional -------------------------------------------------------------
# Mailbox searched when the plugin does not name one.
DEFAULT_MAILBOX=INBOX
# Mailbox that receives the APPENDed copy of each sent message.
# Set to an empty value to skip filing entirely.
SENT_MAILBOX=Sent
# Guard rails.
MAX_BODY_BYTES=1000000
MAX_TEXT_CHARS=40000
MAX_RESULTS=50
