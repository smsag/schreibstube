# --- Bridge ---------------------------------------------------------------
PORT=8080
# Budgets. A request that has not finished by now is not going to, and every
# outbound protocol operation carries its own deadline.
REQUEST_TIMEOUT_MS=30000
UPSTREAM_TIMEOUT_MS=20000
# Repeated authentication failures from one address earn a delay, then a 429.
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_MS=60000
# How long a shutdown waits for in-flight work before exiting anyway.
DRAIN_TIMEOUT_MS=10000

# --- Mail capability ------------------------------------------------------
# Present these variables and the bridge offers mail; omit them all and it does
# not. At least one capability must be configured or the bridge refuses to start.
# The token the plugin sends as "Authorization: Bearer <token>", for the mail
# routes only. Generate with: openssl rand -base64 32
MAIL_TOKEN=replace-me-with-at-least-24-characters

# Mailbox (Strato example).
IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true

MAIL_USER=you@your-domain.de
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM=Your Name <you@your-domain.de>

# --- Mail, optional -------------------------------------------------------
# Mailbox searched when the plugin does not name one.
DEFAULT_MAILBOX=INBOX
# Mailbox that receives the APPENDed copy of each sent message.
# Set to an empty value to skip filing entirely.
SENT_MAILBOX=Sent
# Guard rails.
MAX_BODY_BYTES=1000000
MAX_TEXT_CHARS=40000
MAX_RESULTS=50
