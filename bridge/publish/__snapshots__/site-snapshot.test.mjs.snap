exports[`the awkward vault > renders hallo-welt exactly as it did 1`] = `
"<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hallo Welt — Schreibstube</title>
<meta name="description" content="Der erste Beitrag.">
<link rel="stylesheet" href="../assets/theme.css">
</head>
<body>
<header class="site"><a href="../">Schreibstube</a></header>
<main>
<article>
<p class="meta"><time datetime="2026-09-12">12.09.2026</time></p>
<h1 id="hallo-welt">Hallo Welt</h1>
<p>Ein Absatz mit <a href="../grundstueck-groesse/" class="internal">einem Link</a> und einem toten Fehlt.</p>
<blockquote class="callout callout-warning">
<p class="callout-title">Achtung</p>
<p>Ein Callout mit <strong>Fett</strong> und <code>Code</code>.</p>
</blockquote>
<details class="callout callout-tip"><summary>Eingeklappt</summary>
<p>Versteckt, ohne JavaScript.</p>
</details>
<table>
<thead>
<tr>
<th>Spalte</th>
<th>Wert</th>
</tr>
</thead>
<tbody>
<tr>
<td>a</td>
<td>1</td>
</tr>
</tbody>
</table>
<ul class="contains-task-list">
<li class="task-list-item"><input class="task-list-item-checkbox" checked="" disabled="" type="checkbox"> erledigt</li>
<li class="task-list-item"><input class="task-list-item-checkbox" disabled="" type="checkbox"> offen</li>
</ul>
<p>Eine Fussnote.<sup class="footnote-ref"><a href="#fn1" id="fnref1">[1]</a></sup></p>
<p><img src="../assets/4c4b6a3be131-bild.png" alt="bild.png" loading="lazy"></p>
<hr class="footnotes-sep">
<section class="footnotes">
<ol class="footnotes-list">
<li id="fn1" class="footnote-item"><p>Die Anmerkung. <a href="#fnref1" class="footnote-backref">↩︎</a></p>
</li>
</ol>
</section>
</article>
</main>
</body>
</html>
"
`;

